# Anthropic API
ANTHROPIC_API_KEY=

# SMTP リレー
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# sources.yaml のパス（省略時は sources.yaml）
# SOURCES_PATH=sources.yaml

# SQLite の DB ファイルのパス（省略時は data/aidigest.db）
# DB_PATH=data/aidigest.db

# 外部への HTTP アクセス（省略時は既定値）
# USER_AGENT=aidigest/0.1 (+https://github.com/dreammind/ai-digest)
# HTTP_TIMEOUT_SECONDS=20
# HTTP_RETRIES=2
# HTTP_BACKOFF_SECONDS=1.0
# HOST_INTERVAL_SECONDS=1.0

# 時間窓（時間。省略時は 36）
# TIME_WINDOW_HOURS=36

# topics.yaml のパス（省略時は topics.yaml）
# TOPICS_PATH=topics.yaml

# LLM（省略時は既定値。単価は pricing.yaml）
# LLM_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# PRICING_PATH=pricing.yaml

# 予算（USD）と円換算の為替レート
# BUDGET_DAILY_USD=0.15
# BUDGET_MONTHLY_USD=2.0
# USD_JPY_RATE=160

# LLM の再ランク（省略時は既定値）
# RERANK_TOP_N=30
# RERANK_EXCERPT_CHARS=200
# RERANK_LLM_WEIGHT=0.5
# RERANK_MAX_TOKENS=4000

# 要約（省略時は既定値）
# SUMMARY_BODY_CHARS=4000
# SUMMARY_MAX_TOKENS=4000

# テンプレートと静的 HTML の出力先（省略時は既定値）
# TEMPLATES_DIR=templates
# OUTPUT_DIR=output

# SMTP の暗号化の方式（starttls: 587 番 / ssl: 465 番）と、タイムアウト・再試行（省略時は既定値）
# SMTP_SECURITY=starttls
# SMTP_TIMEOUT_SECONDS=30
# SMTP_RETRIES=1
# SMTP_RETRY_WAIT_SECONDS=10
