<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0; padding:16px; background:#f4f5f7; color:#1f2328; font-family:-apple-system, 'Hiragino Sans', 'Noto Sans JP', sans-serif; line-height:1.6;">
<div style="max-width:640px; margin:0 auto; background:#ffffff; padding:24px; border-radius:8px;">
  <h1 style="font-size:20px; margin:0 0 16px;">AI Digest {{ day }}</h1>
{% if notices %}
  <div style="margin:0 0 20px; padding:12px 16px; background:#fff8e1; border-left:4px solid #f0b400;">
    <strong>お知らせ</strong>
    <ul style="margin:8px 0 0; padding-left:20px;">
{% for notice in notices %}
      <li>{{ notice }}</li>
{% endfor %}
    </ul>
  </div>
{% endif %}
{% if not sections %}
  <p>本日の注目記事はありません。</p>
{% endif %}
{% for section in sections %}
  <h2 style="font-size:16px; margin:28px 0 12px; padding-bottom:4px; border-bottom:2px solid #1f6feb;">{{ section.heading }}</h2>
{% for article in section.articles %}
  <div style="margin:0 0 20px;">
    <a href="{{ article.url }}" style="font-size:15px; font-weight:bold; color:#0b57d0; text-decoration:none;">{{ article.title }}</a>
{% if article.summary is not none %}
    <p style="margin:6px 0;">{{ article.summary }}</p>
{% if article.apply %}
    <p style="margin:6px 0; padding:8px 12px; background:#f1f8f4; border-radius:4px;"><strong>AI活用</strong>：{{ article.apply }}</p>
{% endif %}
{% else %}
    <p style="margin:6px 0; color:#6e7781;">要約なし</p>
{% endif %}
    <p style="margin:4px 0 0; font-size:12px; color:#6e7781;">{{ article.source }} ・ <a href="{{ article.url }}" style="color:#6e7781;">原文</a></p>
  </div>
{% endfor %}
{% endfor %}
  <hr style="margin:28px 0 16px; border:none; border-top:1px solid #d0d7de;">
  <div style="font-size:12px; color:#57606a;">
    <p style="margin:0 0 4px;"><strong>取得に失敗したソース</strong></p>
{% if failed %}
    <ul style="margin:0 0 12px; padding-left:20px;">
{% for source in failed %}
      <li>{{ source.source_id }}：{{ source.error }}</li>
{% endfor %}
    </ul>
{% else %}
    <p style="margin:0 0 12px;">すべてのソースから取得できました</p>
{% endif %}
    <p style="margin:0;"><strong>LLM の費用</strong>：{{ cost }}</p>
  </div>
</div>
</body>
</html>
